# PostgreSQL connection string (local or Supabase). Never commit a real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exammentor?schema=public"

# Used to sign nothing secret client-side; session tokens are random and stored hashed.
# Set to "true" in production behind HTTPS so cookies get the Secure flag.
SECURE_COOKIES="false"

# Optional: AI tutor provider. Leave blank to use the deterministic offline tutor.
# AI_PROVIDER can be "anthropic" or "none".
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Allow provisionally accepted (AI-authored, automatically checked, not yet human-reviewed)
# questions in mocks. They are always labelled in the UI.
ALLOW_PROVISIONAL_QUESTIONS="true"

# Maximum upload size for admin imports, in bytes (default 5 MB).
MAX_UPLOAD_BYTES="5242880"
CRON_SECRET=""
